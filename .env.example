# The tide boards are optional: with neither pair set, /api/leaderboard answers 503
# with storage 'unavailable' and the game keeps its board on the device.
# A dedicated pair wins over the generic Vercel KV names.
LEADERBOARD_KV_REST_URL=
LEADERBOARD_KV_REST_TOKEN=

# Vercel KV / Upstash Redis REST, the names Vercel provisions by default.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Set to "false" to force the on-device board in a build even when storage exists.
# VITE_LEADERBOARD_API=false
